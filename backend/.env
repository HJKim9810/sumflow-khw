# =======================
# [merge 엔진 호환 alias]
# =======================
# merge 엔진은 OLLAMA_HOST / OLLAMA_MODEL / OCR_* 변수명을 사용함
# 아래 alias로 sumflow의 기존 변수와 동기화

# sumflow 기본
OLLAMA_BASE=http://127.0.0.1:11434
LLM_MODEL=gemma3-summarizer

# merge 엔진 호환 alias
OLLAMA_HOST=${OLLAMA_BASE}
OLLAMA_MODEL=${LLM_MODEL}

# OCR 고급 옵션 (없으면 기본값)
OCR_TEXTLAYER_FIRST=1
OCR_UPSCALE=0
OCR_DESKEW=0
